DATABASE_URL=postgresql://user:password@localhost:5432/dbname
PORT=5000
NODE_ENV=development

# Optional: require Bearer or X-API-Key for POST /api/flows/:id/run and POST /api/flows/run
# FLOW_RUN_API_KEY=

# Publish to AIMSIS (server-to-server). Both must be set to enable the Publish button.
# URL is the tenant's endpoint; TOKEN must match AIMSIS's REPORTCALC_PUBLISH_TOKEN env.
# AIMSIS_PUBLISH_URL=https://<school>.ac.aimsis.com/reportcalculationapi/publish
# AIMSIS_PUBLISH_TOKEN=